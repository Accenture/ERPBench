# Copy this file to .env. docker compose auto-loads it on `docker compose up`.
#
# Choose a brain (BRAIN_PROVIDER), then fill in the keys for that provider.
# Other providers' keys can be left blank.

# === Brain selection ===
# Values: claude | qwen | opencua | uitars | holo3
BRAIN_PROVIDER=claude

# === Claude (BRAIN_PROVIDER=claude) ===
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# === Qwen3-VL via an OpenAI-compatible endpoint (BRAIN_PROVIDER=qwen) ===
# Base URL example: https://<your-endpoint>/v1
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=qwen3-vl-32b-instruct

# === OpenCUA 7B/32B served with vLLM (BRAIN_PROVIDER=opencua) ===
# Same brain for any size — set OPENCUA_MODEL to the served model name
# (opencua-32b or opencua-7b). Base URL example: https://<your-vllm-endpoint>/v1
# OPENCUA_API_KEY=
# OPENCUA_BASE_URL=
# OPENCUA_MODEL=opencua-32b
#   Tag benchmark runs to match, so results never mix:
#     python3 runner.py --suite t1 --brain opencua-32b --runs 5
#     python3 runner.py --suite t1 --brain opencua-7b  --runs 5

# === UI-TARS hosted API (BRAIN_PROVIDER=uitars) ===
# OpenAI-compatible endpoint serving UI-TARS-1.5.
# Base URL example: https://<your-vllm-endpoint>/v1
# UITARS_API_KEY=
# UITARS_API_BASE_URL=
# UITARS_API_MODEL=ui-tars-1-5-7b

# === Holo3-35B-A3B (BRAIN_PROVIDER=holo3) ===
# Base URL example: https://<your-vllm-endpoint>/v1
# HOLO3_API_KEY=
# HOLO3_API_BASE_URL=
# HOLO3_API_MODEL=holo3-35b-a3b

# === ERPNext browser credentials ===
# The runner logs the agent's in-container browser in with these before each
# task if it lands on the login page. Defaults match the site docker-compose
# creates (Administrator / admin); change them only if you changed that password.
# ERPNEXT_BROWSER_USR=Administrator
# ERPNEXT_BROWSER_PWD=admin

# === Common (optional overrides — leave blank to use defaults) ===
# TARGET_URL=http://erpnext-frontend:8080      # what Chromium opens
# MAX_TURNS_PER_TASK=50                        # hard cap on brain turns per task

# === Executor tweaks ===
# EXECUTOR_SAVE_REWRITE=on|off  (default: on)
# When 'on', the executor intercepts click_button on a Save/Submit/Update button
# (matched via button_role=="save" OR button_label in {Save, Submit, Update})
# and dispatches Ctrl+S via Frappe's global keydown handler instead of a pixel
# click. This bypasses a toolbar-Save pixel-grounding failure. Set to 'off' to
# force plain pixel clicks.
# EXECUTOR_SAVE_REWRITE=on
